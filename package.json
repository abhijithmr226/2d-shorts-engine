{
  "name": "2d-shorts-engine",
  "version": "1.0.0",
  "description": "Hybrid 2D/3D cartoon animation and video production engine for viral shorts",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "remotion preview src/index.ts",
    "preview": "remotion preview src/index.ts",
    "build": "remotion render src/index.ts Short out/video.mp4 --concurrency=4 --gl=angle",
    "render": "remotion render src/index.ts Short out/video.mp4 --concurrency=4 --gl=angle",
    "still": "remotion still src/index.ts Shot out/thumbnail.png --frame=550 --gl=angle"
  },
  "dependencies": {
    "@react-three/fiber": "8.17.10",
    "@remotion/cli": "4.0.534",
    "@remotion/google-fonts": "^4.0.534",
    "@remotion/three": "4.0.534",
    "kokoro-js": "1.2.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.534",
    "three": "0.170.0"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/three": "0.170.0",
    "typescript": "5.6.3"
  }
}
